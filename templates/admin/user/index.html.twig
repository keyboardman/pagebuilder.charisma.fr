{% extends 'base.html.twig' %}

{% block body %}
  <div class="max-w-4xl space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold tracking-tight">Comptes</h1>
      <div class="flex gap-2">
        <a href="{{ path('app_admin_compte_add') }}" class="btn btn-primary">Nouvelle utilisateur</a>
      </div>
    </div>

    <div class="container mt-3">
      {% set successMessages = app.flashes('success') %}
      {% if successMessages is not empty %}
        <p class="text-sm text-green-600">
          {%- for message in successMessages -%}
            {{ message }}{% if not loop.last %}. {% endif %}
          {%- endfor -%}
        </p>
      {% endif %}
      {% set warningMessages = app.flashes('warning') %}
      {% if warningMessages is not empty %}
        <p class="text-sm text-destructive">
          {%- for message in warningMessages -%}
            {{ message }}{% if not loop.last %}. {% endif %}
          {%- endfor -%}
        </p>
      {% endif %}
    </div>

    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="table-shadcn">
          <thead>
            <tr>
              <th>#</th>
              <th>Email</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for user in comptes %}
              <tr>
                <td>{{ loop.index }}</td>
                <td>{{ user.email }}</td>
                <td>
                  <div class="flex items-center gap-2">
                    <a href="{{ path('app_admin_compte_edit', { id: user.id }) }}" class="btn btn-ghost btn-sm">Modifier</a>
                    <form method="post" action="{{ path('app_admin_compte_delete', { id: user.id }) }}" onsubmit="return confirm('Confirmer la suppression de ce compte ?');">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                      <button class="btn btn-ghost btn-sm text-red-600" type="submit">Supprimer</button>
                    </form>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="4" class="text-muted-foreground">Aucune utilisateur.</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
{% endblock %}
