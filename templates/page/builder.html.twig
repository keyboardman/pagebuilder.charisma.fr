<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ page.description|default('') }}">
    <title>Builder — {{ page.title }}</title>
    
    
    {{ encore_entry_link_tags('pageBuilderStandalone') }}
    {% if page.theme.generatedCssPath %}
        <link rel="stylesheet" href="{{ path('app_theme_css', { id: page.theme.id }) }}">
    {% endif %}
    
</head>
<body class="page-builder-standalone-body">
    {# Scripts du builder AVANT encore_entry_js_files('videoPlayer') : sinon runtime.js est marqué
       comme déjà rendu et n'est plus inclus dans les balises script du builder (page blanche). #}
    {{ encore_entry_script_tags('pageBuilderStandalone') }}

    <main class="page-builder-standalone-body__main">
        {% set default_content = '{"cylsqgudkwtz":{"id":"cylsqgudkwtz","type":"node-root","parent":null,"content":{"title":""}}}' %}
        {% set content_json = (page.content is defined and page.content is not empty) ? (page.content|json_encode(constant('JSON_UNESCAPED_UNICODE'))) : default_content %}
        {% set base_url = app.request.schemeAndHttpHost ~ app.request.basePath %}
        {% set render_css_paths = encore_entry_css_files('pagePreview')|merge(encore_entry_css_files('videoPlayer')) %}
        {% set render_css_urls = render_css_paths|map(p => base_url ~ p)|default([]) %}
        {% set render_script_paths = encore_entry_js_files('videoPlayer') %}
        {% set render_script_urls = render_script_paths|map(p => base_url ~ p)|default([]) %}
        {% import 'page/_builder_api_base_url.html.twig' as builder_api %}
        {% set builder_api_base = builder_api.base_url() %}
        <script type="application/json" id="page-builder-data">
        {{ {
            content: content_json,
            csrfToken: csrf_token('page_form'), 
            saveUrl: path('app_page_api_content', { id: page.id }), 
            backUrl: path('app_page_edit', { id: page.id }), 
            pageTitle: page.title,
            pageMetaTitle: page.effectiveMetaTitle,
            pageDescription: page.description|default(''),
            baseUrl: base_url, 
            themeCssUrl: page.theme.generatedCssPath ? path('app_theme_css', { id: page.theme.id }) : '', 
            renderCssUrls: render_css_urls,
            renderScriptUrls: render_script_urls, 
            themeFonts: theme_fonts|default([]),
            themeFontIds: theme_font_ids|default([]),
            apiCardsBaseUrl: builder_api_base,
            pageBuilderApiBaseUrl: builder_api_base, 
            filemanagerUrl: url('keyboardman_filemanager', {'filesystem': 'default', 'mode': 'iframe'}), 
            resolveUrl: path('keyboardman_filemanager'),
            themeIcons: theme_icons|default([]),
            themeNodeOverrides: theme_node_overrides|default({}),
            themeVars: theme_vars|default({})
        }|json_encode|raw }}
        </script>
        
        <div id="page-builder-standalone-root" class="page-builder-standalone-body__root"></div>
    </main>
</body>
</html>
