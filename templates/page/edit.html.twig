{% extends 'base.html.twig' %}

{% block title %}Modifier {{ page.title }}{% endblock %}

{% block body %}
<div class="max-w-4xl space-y-6">
    <div class="flex items-center justify-between gap-4 flex-wrap">
        <div>
            <a href="{{ path('app_page_index') }}" class="btn btn-ghost btn-sm mb-2">← Retour</a>
            <h1 class="text-2xl font-bold tracking-tight">Modifier la page</h1>
        </div>
        <div class="flex items-center gap-2">
            <a href="{{ path('app_page_builder', { id: page.id }) }}" class="btn btn-outline btn-sm">Builder</a>
            <a href="{{ path('app_page_preview', { id: page.id }) }}" class="btn btn-outline btn-sm" target="_blank" rel="noopener">Prévisualiser</a>
        </div>
    </div>

    {{ form_start(form, { attr: { class: 'space-y-6' } }) }}
    <div class="card p-4 space-y-4">
        <h2 class="text-lg font-semibold">Page</h2>
        <div class="grid w-full mb-2 gap-2">
            {{ form_label(form.title) }}
            {{ form_widget(form.title) }}
            {{ form_errors(form.title) }}
            <p class="text-xs text-muted-foreground">Le slug (URL) est calculé automatiquement à partir du titre.</p>
        </div>
        {{ form_row(form.theme, { attr: { class: 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2' } }) }}
        
    </div>
    <div class="card p-4 space-y-4">
        <h2 class="text-lg font-semibold">SEO</h2>
        <div class="space-y-2">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, { attr: { class: 'flex min-h-[80px] rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm w-full' } }) }}
            {{ form_errors(form.description) }}
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}
</div>
{% endblock %}
