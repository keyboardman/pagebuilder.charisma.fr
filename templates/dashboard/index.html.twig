{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold tracking-tight">Dashboard</h1>
        <p class="text-muted-foreground">Bienvenue sur le générateur de thèmes.</p>
    </div>
   
    <div class="grid grid-cols-2 gap-4">
        <a href="{{ path('app_font_index') }}" class="block">
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6 transition-colors hover:bg-muted/50">
                <h2 class="text-lg font-semibold">Polices</h2>
                <p class="text-sm text-muted-foreground">Gérer les polices (native, Google, custom).</p>
                <p class="text-2xl font-semibold text-primary">{{ font_count }}</p>
            </div>
        </a>    
        <a href="{{ path('app_theme_index') }}" class="block">
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6 transition-colors hover:bg-muted/50">
                <h2 class="text-lg font-semibold">Thèmes</h2>
                <p class="text-sm text-muted-foreground">Créer et éditer les thèmes CSS.</p>
                <p class="text-2xl font-semibold text-primary">{{ theme_count }}</p>
            </div>
        </a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
