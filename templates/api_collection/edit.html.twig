{% extends 'base.html.twig' %}

{% block title %}Modifier {{ definition.label }}{% endblock %}

{% block body %}
<div class="max-w-4xl space-y-6">
    <div>
        <a href="{{ path('app_api_collection_index') }}" class="btn btn-ghost btn-sm mb-2">← Retour</a>
        <h1 class="text-2xl font-bold tracking-tight">Modifier « {{ definition.label }} »</h1>
        <p class="text-sm text-muted-foreground mt-1">
            apiId&nbsp;: <code class="text-xs">{{ definition.apiId }}</code>
        </p>
    </div>

    {% include 'api_collection/_form.html.twig' with { submit_label: 'Enregistrer' } %}

    <div class="card p-4 space-y-4">
        <div>
            <h2 class="text-lg font-semibold">Tester le mapping</h2>
            <p class="text-sm text-muted-foreground mt-1">
                Appelle l’API distante avec la configuration enregistrée et affiche 1 à 3 items déjà mappés.
            </p>
        </div>
        <form method="post" action="{{ path('app_api_collection_test', { id: definition.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('test_api_collection' ~ definition.id) }}">
            <button type="submit" class="btn btn-secondary">Tester (1–3 items)</button>
        </form>

        {% if testError %}
            <p class="text-sm text-destructive">{{ testError }}</p>
        {% endif %}

        {% if testResult is not null and testResult is not empty %}
            <pre class="text-xs overflow-x-auto rounded-md border bg-muted p-3">{{ testResult|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        {% endif %}
    </div>
</div>
{% endblock %}
