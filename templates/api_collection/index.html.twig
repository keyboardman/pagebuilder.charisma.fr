{% extends 'base.html.twig' %}

{% block title %}APIs collection{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold tracking-tight">APIs collection</h1>
        <a href="{{ path('app_api_collection_new') }}" class="btn btn-primary">Nouvelle API</a>
    </div>

    <p class="text-sm text-muted-foreground max-w-3xl">
        Déclarations consommées par <strong>NodeCollection</strong> via
        <code class="text-xs">/api/page-builder/collections</code>.
        Les APIs PHP (adapters) restent disponibles en parallèle.
    </p>

    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table-shadcn">
                <thead>
                    <tr>
                        <th>Libellé</th>
                        <th>apiId</th>
                        <th>Type</th>
                        <th>Modes</th>
                        <th>Actif</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for d in definitions %}
                    <tr>
                        <td>{{ d.label }}</td>
                        <td><code class="text-xs">{{ d.apiId }}</code></td>
                        <td>{{ d.type }}</td>
                        <td>{{ d.supportedModes|join(', ') }}</td>
                        <td>{{ d.enabled ? 'Oui' : 'Non' }}</td>
                        <td class="text-end">
                            <div class="flex gap-2 justify-end">
                                <a href="{{ path('app_api_collection_edit', { id: d.id }) }}" class="btn btn-ghost btn-sm">Modifier</a>
                                <form method="post" action="{{ path('app_api_collection_delete', { id: d.id }) }}" class="inline" onsubmit="return confirm('Supprimer « {{ d.label|e('js') }} » ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_api_collection' ~ d.id) }}">
                                    <button type="submit" class="btn btn-ghost btn-sm text-destructive">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="6" class="text-muted-foreground">Aucune API déclarée.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
