{% extends 'base.html.twig' %}

{% block title %}Formulaires (builder){% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold tracking-tight">Formulaires du builder</h1>
        <a href="{{ path('app_builder_form_config_new') }}" class="btn btn-primary">Nouveau formulaire</a>
    </div>

    <p class="text-sm text-muted-foreground max-w-3xl">
        Ces configurations alimentent le catalogue du bloc <strong>NodeForm</strong> dans l’éditeur.
        Endpoint public de soumission (POST)&nbsp;: <code class="text-xs">/api/page-builder/forms/{slug}/submit</code>
    </p>

    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table-shadcn">
                <thead>
                    <tr>
                        <th>Libellé</th>
                        <th>Slug</th>
                        <th>URL de soumission</th>
                        <th>Actif</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for f in forms %}
                    <tr>
                        <td>{{ f.label }}</td>
                        <td><code class="text-xs">{{ f.slug }}</code></td>
                        <td>
                            <code class="text-xs break-all">{{ absolute_url(path('_api_/page-builder/forms/{slug}/submit_post', { slug: f.slug })) }}</code>
                        </td>
                        <td>{{ f.enabled ? 'Oui' : 'Non' }}</td>
                        <td class="text-end">
                            <div class="flex gap-2 justify-end">
                                <a href="{{ path('app_builder_form_config_edit', { id: f.id }) }}" class="btn btn-ghost btn-sm">Modifier</a>
                                <form method="post" action="{{ path('app_builder_form_config_delete', { id: f.id }) }}" class="inline" onsubmit="return confirm('Supprimer « {{ f.label|e('js') }} » ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_builder_form' ~ f.id) }}">
                                    <button type="submit" class="btn btn-ghost btn-sm text-destructive">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="5" class="text-muted-foreground">Aucun formulaire configuré.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
